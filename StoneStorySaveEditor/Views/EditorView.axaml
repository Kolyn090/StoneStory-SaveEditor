<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StoneStorySaveEditor.ViewModels"
             x:Class="StoneStorySaveEditor.Views.EditorView"
             x:DataType="vm:EditorViewModel">

        <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,*" Margin="16" RowSpacing="12">

        <StackPanel Grid.Row="0" Spacing="4">
                <TextBlock Text="Raw JSON Editor"
                        FontSize="24"
                        FontWeight="Bold" />

                <TextBlock Text="{Binding StatusText}"
                        FontSize="14"
                        Opacity="0.75"
                        TextWrapping="Wrap" />
        </StackPanel>

        <!-- Search bar -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <TextBox x:Name="SearchBox"
                        Text="{Binding SearchText, Mode=TwoWay}"
                        Watermark="Search JSON..."
                        FontSize="14" />

                <Button Grid.Column="1"
                        Content="Find"
                        Click="FindButton_Click" />

                <Button Grid.Column="2"
                        Content="Find Next"
                        Click="FindNextButton_Click" />
        </Grid>

        <!-- Tools -->
        <Border Grid.Row="2"
                Padding="10"
                BorderBrush="Gray"
                BorderThickness="1"
                CornerRadius="8">
        <StackPanel Spacing="8">
                <TextBlock Text="Tools"
                        FontSize="16"
                        FontWeight="Bold" />

                <WrapPanel>
                <Button Content="Unlock All Cosmetics"
                        Command="{Binding UnlockAllCosmeticsCommand}"
                        Margin="0,0,8,0" />
                </WrapPanel>
        </StackPanel>
        </Border>

        <!-- Editable JSON -->
        <ScrollViewer Grid.Row="3"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Auto">
                <TextBox x:Name="JsonEditor"
                        Text="{Binding DecryptedText, Mode=TwoWay}"
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        FontFamily="Consolas, Cascadia Mono, monospace"
                        FontSize="14"
                        Padding="12"
                        Watermark="Edit JSON here..."
                        MinHeight="300" />
        </ScrollViewer>

        <!-- Buttons -->
        <Grid Grid.Row="4" ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">
                <Button Grid.Column="0"
                        Content="Back"
                        Command="{Binding BackCommand}" />

                <Button Grid.Column="1"
                        Content="Export"
                        Command="{Binding ExportCommand}" />

                <TextBlock Grid.Column="2"
                        Text="{Binding StatusText}"
                        VerticalAlignment="Center"
                        Opacity="0.8"
                        TextWrapping="Wrap" />
        </Grid>

        <!-- Exported full save text -->
        <ScrollViewer Grid.Row="5"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Auto">
                <TextBox Text="{Binding OutputText, Mode=TwoWay}"
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        FontFamily="Consolas, Cascadia Mono, monospace"
                        FontSize="14"
                        Padding="12"
                        Watermark="Exported full save text will appear here after clicking Export..."
                        MinHeight="200" />
        </ScrollViewer>

        </Grid>
</UserControl>