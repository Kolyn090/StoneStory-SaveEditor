<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:StoneStorySaveEditor"
             xmlns:vm="using:StoneStorySaveEditor.ViewModels"
             xmlns:views="using:StoneStorySaveEditor.Views"
             x:Class="StoneStorySaveEditor.App"
             RequestedThemeVariant="Default">

    <Application.DataTemplates>
        <DataTemplate DataType="{x:Type vm:PasteSaveViewModel}">
            <views:PasteSaveView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:EditorViewModel}">
            <views:EditorView />
        </DataTemplate>
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>
</Application>